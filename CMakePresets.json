{
    "version": 7,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 27,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17",
                "CMAKE_C_STANDARD": "17"
            }
        },
        {
            "name": "windows-debug",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/windows-$penv{Platform}",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "$penv{Platform}-windows-static",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/LabVIEW/common"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-desktop-debug",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build/linux-desktop",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-ci",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/LabVIEW/common"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-release",
            "inherits": "windows-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-desktop-release",
            "inherits": "linux-desktop-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "nilrt-armv7a-cross",
            "inherits": "linux-desktop-release",
            "binaryDir": "${sourceDir}/build/nilrt-armv7a",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "VCPKG_TARGET_TRIPLET": "armv7a-nilrt-ci",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/scripts/toolchains/nilrt-armv7a.cmake",
                "CMAKE_CXX_STANDARD": "14",
                "CMAKE_C_STANDARD": "11",
                "OMIT_ZXING": "ON",
                "OMIT_DNN": "ON",
                "OMIT_VIDEOIO": "ON",
                "OMIT_TESSERACT": "ON",
                "OMIT_OBJLOADER": "ON"
            }
        },
        {
            "name": "ci",
            "inherits": "base",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}"
            },
            "condition": {
                "type": "equals",
                "lhs": "$penv{CI}",
                "rhs": "true"
            }
        },
        {
            "name": "ci-windows-x86",
            "inherits": "ci",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x86-windows-static-ci"
            }
        },
        {
            "name": "ci-windows-x64",
            "inherits": "ci",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-ci"
            }
        },
        {
            "name": "ci-linux-x64",
            "inherits": "ci",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-ci"
            }
        },
        {
            "name": "ci-linux-armv7a",
            "inherits": "ci",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "nilrt-armv7a-cross"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "targets": "install",
            "configuration": "Debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "targets": "install",
            "configuration": "Release"
        },
        {
            "name": "linux-desktop-debug",
            "configurePreset": "linux-desktop-debug",
            "targets": "install",
            "configuration": "Debug"
        },
        {
            "name": "linux-desktop-release",
            "configurePreset": "linux-desktop-release",
            "targets": "install",
            "configuration": "Release"
        },
        {
            "name": "nilrt-armv7a-cross",
            "configurePreset": "nilrt-armv7a-cross",
            "targets": "install",
            "configuration": "Release"
        },
        {
            "name": "ci-windows-x86",
            "configuration": "Release",
            "configurePreset": "ci-windows-x86"
        },
        {
            "name": "ci-windows-x64",
            "configuration": "Release",
            "configurePreset": "ci-windows-x64"
        },
        {
            "name": "ci-linux-x64",
            "configuration": "Release",
            "configurePreset": "ci-linux-x64"
        },
        {
            "name": "ci-linux-armv7a",
            "configuration": "Release",
            "configurePreset": "ci-linux-armv7a"
        }
    ]
}