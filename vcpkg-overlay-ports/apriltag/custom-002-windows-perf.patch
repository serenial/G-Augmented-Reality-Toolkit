diff --git a/common/time_util.c b/common/time_util.c
index 7a25f42..17ec17c 100644
--- a/common/time_util.c
+++ b/common/time_util.c
@@ -29,6 +29,56 @@ either expressed or implied, of the Regents of The University of Michigan.
 #include <math.h>
 #include "time_util.h"
 
+#ifdef _WIN32
+
+static long long performance_frequency = 0;
+static volatile long performance_components_initialized = 0;
+
+typedef struct{long long QuadPart;} PERF_QUAD_INTEGER;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+__declspec(dllimport) void __stdcall Sleep(unsigned long miliseconds);
+__declspec(dllimport) int __stdcall QueryPerformanceCounter(PERF_QUAD_INTEGER* lpPerformanceCount);
+__declspec(dllimport) int __stdcall QueryPerformanceFrequency(PERF_QUAD_INTEGER* lpFrequency);
+__declspec(dllimport) long __stdcall InterlockedCompareExchange(volatile long* Destination, long Exchange, long Comparand);
+
+#ifdef __cplusplus
+}
+#endif
+
+static void init_perf_components()
+{
+    PERF_QUAD_INTEGER freq;
+    QueryPerformanceFrequency(&freq);
+    performance_frequency = freq.QuadPart;
+}
+
+inline int gettimeofday(struct timeval *tp, void *tzp)
+{
+    (void)tzp;
+
+    PERF_QUAD_INTEGER counter;
+    long long elapsed;
+
+    if (performance_components_initialized == 0)
+    {
+        init_perf_components();
+        InterlockedCompareExchange(&performance_components_initialized, 1, 0);
+    }
+
+    QueryPerformanceCounter(&counter);
+
+    // Convert to seconds and microseconds
+    tp->tv_sec = (time_t)(counter.QuadPart / performance_frequency);
+    tp->tv_usec = (suseconds_t)((counter.QuadPart % performance_frequency) * 1000000LL / performance_frequency);
+
+    return 0;
+}
+#endif
+
 struct timeutil_rest
 {
     int64_t acc_time;
